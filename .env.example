TZ=Europe/Paris
MINIVID_PORT=8080

# Les chemins internes doivent correspondre aux volumes du docker-compose.yml.
MEDIA_DIRS=/videos1|/videos2
MEDIA_NAMES=Vidéos 1|Vidéos 2

DATA_DIR=/data
THUMB_DIR=/cache/thumbs
MINI_ALLOWED_EXT=.mp4,.webm,.mkv,.avi,.flv,.m2ts,.ts
MINI_BANNED_TAGS=and,the,source,video,videos,vid,vids,film,movie,part,les,une,des,ils,elles,sur,sous,dans,par,pour,sans,avec,chez,cet,cette,ces,mon,mes,ton,tes,ses,notre,nos,votre,vos,leur,leurs,qui,que,quoi,dont,quand,comme,your,they,for,with,without,into,onto,about,this,that,these,those,here,there,then,than,are,was,being,been,have,had,just,only,over,under,very,more,most,less,were,com,net

# Lecture directe, puis HLS si le navigateur ne décode pas la vidéo.
MINI_TRANSCODE=1
MINI_HLS_SEGMENT_DURATION=10

# Indexation et miniatures.
MINI_AUTOSCAN=1
MINI_SCAN_INTERVAL=3600
MINI_THUMB_OFFSET=5
MINI_THUMB_MAX=30
MINI_FFPROBE_TIMEOUT=10

# Authentification facultative. Elle est requise pour autoriser les suppressions.
MINI_USER=
MINI_PASS=
SECRET_KEY=
