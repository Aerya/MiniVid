TZ=Europe/Paris
MINIVID_PORT=8080

# Les chemins internes doivent correspondre aux volumes du docker-compose.yml.
MEDIA_DIRS=/videos1|/videos2
MEDIA_NAMES=Vidéos 1|Vidéos 2

DATA_DIR=/data
THUMB_DIR=/cache/thumbs
MINI_ALLOWED_EXT=.mp4,.webm,.mkv,.avi,.flv,.m2ts,.ts

# Lecture directe, puis HLS si le navigateur ne décode pas la vidéo.
MINI_TRANSCODE=1
MINI_HLS_SEGMENT_DURATION=10

# Indexation et miniatures.
MINI_AUTOSCAN=1
MINI_SCAN_INTERVAL=3600
MINI_THUMB_OFFSET=5
MINI_THUMB_MAX=30
MINI_FFPROBE_TIMEOUT=10

# Authentification facultative. Elle est requise pour autoriser les suppressions.
MINI_USER=
MINI_PASS=
SECRET_KEY=

# Facultatif : génération de tags avec Gemini.
GEMINI_API_KEY=
